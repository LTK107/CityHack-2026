# Copy to .env and fill in. .env is gitignored -- never commit real values.

NODE_ENV=development
PORT=4000

# ---- Site catalogue ---------------------------------------------------------
# JSON array of site records. Relative paths resolve against the server package.
SITES_FILE=data/sites.json

# ---- CORS -------------------------------------------------------------------
# Comma-separated exact origins allowed to call this API. Never use "*".
CORS_ORIGINS=http://localhost:5173

# ---- Gemini -----------------------------------------------------------------
# Server-side only. If this key ever appears in the frontend build, rotate it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# ---- Rate limiting ----------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
CHAT_RATE_LIMIT_MAX=15

# Number of trusted proxies in front of this app. Keep 0 unless deployed behind one.
TRUST_PROXY=0
