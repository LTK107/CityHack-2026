# Copy to .env and fill in. .env is gitignored -- never commit real values.

NODE_ENV=development
PORT=4000

# ---- Site catalogue ---------------------------------------------------------
# JSON array of site records. Relative paths resolve against the server package.
SITES_FILE=data/sites.json

# ---- CORS -------------------------------------------------------------------
# Comma-separated exact origins allowed to call this API. Never use "*".
CORS_ORIGINS=http://localhost:5173

# ---- LLM (NaviGator AI LiteLLM gateway) -------------------------------------
# OpenAI-compatible gateway. Server-side only. If this key ever appears in the
# frontend build, rotate it in the NaviGator Toolkit UI.
LLM_API_KEY=
LLM_BASE_URL=https://api.ai.it.ufl.edu/v1
LLM_MODEL=gpt-oss-120b

# ---- Rate limiting ----------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
CHAT_RATE_LIMIT_MAX=15

# Number of trusted proxies in front of this app. Keep 0 unless deployed behind one.
TRUST_PROXY=0
