# Copy to .env only if you need to override the defaults.

# Where `npm run dev` forwards /api and /health. Defaults to the Express port.
API_PROXY_TARGET=http://localhost:4000

# Production builds only: the public origin of the API. Leave unset in dev so
# the app uses relative paths through the Vite proxy.
# VITE_API_BASE=https://api.example.com
